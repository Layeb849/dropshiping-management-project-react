# Node modules
/node_modules/

# Build outputs
/build/
/dist/
/out/

# Environment files (don't commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Editor directories and files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# OS files
.DS_Store
Thumbs.db

# Dependency directories (optional package managers)
.pnp/
.pnp.js
node_modules/

# Cache
.cache/
/.parcel-cache
/.vite

# Testing
/coverage/

# Build reports
report.html
bundle-report.html

# TypeScript
*.tsbuildinfo

# Optional: lock files you may want to ignore (usually you should commit these)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Misc
*.log
/*.local

# If using Next.js (uncomment if needed)
# .next/
# .vercel/

# If using Expo (React Native) (uncomment if needed)
# .expo/
# .expo-shared/

# If using Android/iOS builds (React Native)
# android/
# ios/

# IDE / OS swap/temp files
*.swp
*.swo
